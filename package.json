{
  "name": "orca-pod",
  "version": "0.5.0",
  "description": "Lightweight, governance-hardened multi-agent SDLC orchestrator for Orca ADE — 3-Track pipelines, activity-aware Watchdog supervisor, primary/fallback pre-flight auto-downgrade + agy worktree trust, GitHub/Gitea Issue-to-PR traceability, stack-aware CI & intranet Self-Hosted CD generator, isolated worktrees, hard gates, and out-of-repo run ledger.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shown1985/orca-pod.git"
  },
  "bin": {
    "orca-pod": "bin/init.mjs"
  },
  "scripts": {
    "test": "node test/run-tests.mjs",
    "scan": "node .orca/agent-scanner.mjs",
    "ci-gen": "node .orca/ci-generator.mjs",
    "issues": "node .orca/issue-tracker.mjs"
  },
  "files": [
    ".orca/flow.mjs",
    ".orca/agent-config.mjs",
    ".orca/agent-scanner.mjs",
    ".orca/strategy-wizard.mjs",
    ".orca/gate-verify.mjs",
    ".orca/worktree-isolation.mjs",
    ".orca/merge-danger.mjs",
    ".orca/health.mjs",
    ".orca/watchdog.mjs",
    ".orca/preflight.mjs",
    ".orca/issue-tracker.mjs",
    ".orca/ci-generator.mjs",
    ".orca/ledger.mjs",
    ".orca/lib/orca-cli.mjs",
    ".orca/lib/status.mjs",
    ".orca/lib/status-template.html",
    ".orca/lib/usage.mjs",
    ".orca/lib/notify.mjs",
    ".orca/lib/nudge.mjs",
    ".orca/lib/runner.mjs",
    ".orca/flow.config.json",
    ".orca/flow-hotfix.json",
    ".orca/flow-feature.json",
    ".orca/flow-epic.json",
    ".orca/CONFIGURATION.md",
    ".orca/README.md",
    ".orca/notify.json",
    ".orca/prompts/triage-po.md",
    ".orca/prompts/frontend-worker.md",
    ".orca/prompts/senior-auditor.md",
    "AGENTS.md",
    "DESIGN.md",
    ".worktreeinclude",
    ".github/workflows/ci-release.yml",
    ".gitea/workflows/ci-release.yml",
